@inject IAuthenticationService AuthenticationService
<div class="top-row ps-3 navbar navbar-dark">
	<div class="container-fluid">
		<a class="navbar-brand" href="">ApplicationTracker</a>
	</div>
</div>

@* <input type="checkbox" title="Navigation menu" class="navbar-toggler" /> *@



<div class="nav-scrollable" >
	<nav class="flex-column">
		<div class="nav-item px-3">
			<NavLink class="nav-link" href="" Match="NavLinkMatch.All">
				<span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
			</NavLink>
		</div>

		@if (IsAuthenticated)
		{
		
			<div class="nav-item px-3">
				<NavLink class="nav-link" href="profile">
					<span class="oi oi-person" aria-hidden="true"></span> Show profile
				</NavLink>
			</div>

			<div class="nav-item px-3">
				<NavLink class="nav-link" href="application/new">
					<span class="oi oi-person" aria-hidden="true"></span> Create new
				</NavLink>
			</div>
			<div class="nav-item px-3">
				<NavLink class="nav-link" href="applications">
					<span class="oi oi-person" aria-hidden="true"></span> View apps
				</NavLink>
			</div>
		}

	</nav>
</div>




@code {

	private bool IsAuthenticated = false;
	protected override async Task OnInitializedAsync()
	{
		IsAuthenticated = await AuthenticationService.IsUserAuthenticatedAsync();
	}

}